+         LUA_MULTRET needs exactly one (B stays 0). */
+      if (nresults != LUA_MULTRET)  /* fixed number of results? */
+        SETARG_B(fs->f->code[pc + 2], nresults - 1);  /* widen OP_SETTOP */
+    }
+  }
