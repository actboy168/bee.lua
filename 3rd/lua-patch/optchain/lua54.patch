+static void luaK_setreturns_optchain (FuncState *fs, expdesc *e, int nresults) {
+  if (e->k == VCALL) {  /* open function call? */
+    int pc = e->u.info;  /* position of the call */
+    if (TESTARG_k(fs->f->code[pc])) {  /* optional-chain call (fixed layout)? */
